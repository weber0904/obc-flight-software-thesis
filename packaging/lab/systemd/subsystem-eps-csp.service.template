[Unit]
Description=Subsystem EPS CSP Lab Service
PartOf=__STACK_TARGET_NAME__
After=network-online.target __EPS_ADCS_CAN_SERVICE_NAME__
Wants=__EPS_ADCS_CAN_SERVICE_NAME__

[Service]
Type=simple
User=__TARGET_USER__
WorkingDirectory=__REMOTE_DIR__
Environment=CSP_TRANSPORT=socketcan
Environment=SUBSYSTEM_SIM_CSP_CAN_DEVICE=__EPS_ADCS_CAN_DEVICE__
Environment=CSP_CAN_PROMISC=__CSP_CAN_PROMISC__
Environment=EPS_CSP_NODE_ID=__EPS_CSP_NODE_ID__
Environment=EPS_SIM_CONTROL_SOCKET=__EPS_SIM_CONTROL_SOCKET__
ExecStart=__REMOTE_DIR__/scripts/run_subsystem_csp_service.sh eps
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=__STACK_TARGET_NAME__
