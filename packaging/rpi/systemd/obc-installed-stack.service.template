[Unit]
Description=OBC Installed Stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__TARGET_USER__
WorkingDirectory=__INSTALL_ROOT__/current
Environment=GDS_HOST=127.0.0.1
Environment=GDS_PORT=0
Environment=RADIO_PORT=7000
Environment=RUNTIME_ROOT=__RUNTIME_ROOT__
Environment=PERSISTENT_ROOT=__RUNTIME_ROOT__/persistent-data
Environment=STAGING_ROOT=__RUNTIME_ROOT__/staging
Environment=LOG_ROOT=__RUNTIME_ROOT__/logs
Environment=OBC_HEADLESS=1
Environment=BOOT_TRUST=hmac-sha256
Environment=BOOT_TRUST_SIGNER_ID=repo-dev-boot-signer
Environment=BOOT_TRUST_KEY_SLOT=1
Environment=BOOT_TRUST_KEY_HEX=424f4f545f54525553545f434841494e5f56315f4445565f4b4559
ExecStart=__INSTALL_ROOT__/current/launch/run_stack.sh
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
